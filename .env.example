# =====================================================================
# CareFlow Environment Configuration
# =====================================================================

# Model Execution Mode:
# - 'mock': Fast, deterministic clinical mock adapter for testing without GPU/weights (Default)
# - 'hosted': Connects to a user-configured inference endpoint serving Google MedGemma
# - 'local': Loads Google MedGemma locally via Hugging Face Transformers
MEDGEMMA_MODE=mock

# MedGemma Model Identifier (for local or hosted reference)
MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it

# Hosted endpoint URL (when MEDGEMMA_MODE=hosted, e.g. Hugging Face Inference Endpoint or TGI / vLLM)
MEDGEMMA_ENDPOINT=

# Authentication token for Hugging Face / Hosted Endpoint (supports MEDGEMMA_API_KEY or standard HF_TOKEN)
# NEVER commit tokens to Git. For gated model access: https://huggingface.co/google/medgemma-1.5-4b-it
MEDGEMMA_API_KEY=
HF_TOKEN=

# Local quantization settings (when MEDGEMMA_MODE=local): '4bit', '8bit', or 'none'
MEDGEMMA_LOCAL_QUANTIZATION=4bit

# Model Inference Timeouts and Retries
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1

# =====================================================================
# Voice / Speech-to-Text (STT) & Audio Configuration:
# =====================================================================
# Primary Engine: Deepgram Python SDK (Active Default, optimized for Hinglish & Indian accents)
# Feature flag: Set to 'false' if you need to revert to legacy Whisper engines
USE_DEEPGRAM=true

# Deepgram API Key (Get free key with $200 credits at https://console.deepgram.com)
# NEVER commit keys to Git.
DEEPGRAM_API_KEY=

# Deepgram Model & Language Settings
# - model: 'nova-2' is recommended for highest clinical accuracy and code-switching
# - language: 'en-IN' (English - India) is optimized for Indian accents & Hinglish
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-IN

# ---------------------------------------------------------------------
# Legacy / Fallback Voice Configuration (Hugging Face / Groq Whisper):
# Preserved under feature flag USE_DEEPGRAM=false or fallback
# ---------------------------------------------------------------------
ASR_MODE=hosted
WHISPER_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3

# Hugging Face Whisper alternative endpoint
# WHISPER_ENDPOINT=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3
# WHISPER_API_KEY=hf_your_token

# Local Whisper settings (only used if ASR_MODE=local)
ASR_MODEL_SIZE=base
ASR_DEVICE=cpu

# OCR Engine Configuration:
# - 'auto': Checks winocr first, then paddleocr fallback, then pytesseract
# - 'winocr': Windows native OCR
# - 'paddleocr': Multilingual PaddleOCR (English + Hindi/Devanagari)
OCR_ENGINE=auto

# Cache & Storage Directories (Set to D: on Windows to conserve C: drive space)
# e.g., D:\huggingface\hub
HF_HOME=
CAREFLOW_TEMP_DIR=

# Database Connection (SQLite default for zero-config persistence)
DATABASE_URL=sqlite:///./careflow.db

# Intake Protocol Limits
MAX_FOLLOWUP_QUESTIONS=8

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Streamlit Frontend Configuration
STREAMLIT_SERVER_PORT=8501
